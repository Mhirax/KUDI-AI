// Kudi AI Bank — Prisma Schema (Phase 1 Foundation)
// Domain models are intentionally omitted; this establishes datasource,
// generator, and connection configuration only.

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================================================
// Identity & Auth bounded context (modules/identity)
// Domain entities (Account, Transaction, Ledger, etc.) for other
// bounded contexts are added module-by-module in subsequent phases,
// each respecting its own bounded-context ownership boundary.
// ==========================================================================

enum UserRole {
  CUSTOMER
  SUPPORT_AGENT
  COMPLIANCE_OFFICER
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  LOCKED
  DEACTIVATED
}

model User {
  id                  String    @id @default(uuid())
  email               String    @unique
  phoneNumber         String    @unique
  passwordHash        String
  firstName           String
  lastName            String
  role                UserRole  @default(CUSTOMER)
  status              UserStatus @default(PENDING_VERIFICATION)
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  refreshTokens RefreshToken[]

  @@index([status])
  @@map("users")
}

model RefreshToken {
  id                String    @id @default(uuid())
  userId            String
  tokenHash         String    @unique
  family            String
  expiresAt         DateTime
  revokedAt         DateTime?
  replacedByTokenId String?
  ipAddress         String?
  userAgent         String?
  createdAt         DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([family])
  @@map("refresh_tokens")
}

// ==========================================================================
// Accounts & Wallets bounded context (modules/accounts)
// Note: `userId` on Account is a plain scalar reference to Identity's
// User.id — deliberately *not* a Prisma relation, preserving
// bounded-context isolation at the database level (see
// modules/accounts/README.md).
// ==========================================================================

enum AccountType {
  WALLET
  SAVINGS
  CURRENT
}

// Mirrors shared/enums/account-status.enum.ts
enum AccountStatus {
  ACTIVE
  DORMANT
  FROZEN
  CLOSED
  PENDING_VERIFICATION
}

model Account {
  id            String        @id @default(uuid())
  userId        String
  accountNumber String        @unique
  accountType   AccountType
  currency      String
  /// Minor units (kobo/cents), stored as a native BigInt — never a float.
  balance       BigInt        @default(0)
  status        AccountStatus @default(PENDING_VERIFICATION)
  /// Optimistic concurrency token; incremented on every mutation.
  version       Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([userId])
  @@index([status])
  @@map("accounts")
}

// ==========================================================================
// Transfers bounded context (modules/transfers)
// `sourceAccountId`/`destinationAccountId` are plain scalar references
// to Accounts' Account.id — deliberately not Prisma relations, for the
// same bounded-context-isolation reason as Account.userId above.
// ==========================================================================

enum TransferType {
  INTERNAL
  EXTERNAL
}

// Mirrors shared/enums/transaction-status.enum.ts
enum TransactionStatus {
  PENDING
  PROCESSING
  SUCCESSFUL
  FAILED
  REVERSED
  CANCELLED
}

model Transfer {
  id                     String            @id @default(uuid())
  /// Also serves as the platform's idempotency key for transfer initiation.
  reference              String            @unique
  type                   TransferType
  initiatorUserId        String
  sourceAccountId        String
  /// Populated for INTERNAL transfers only.
  destinationAccountId   String?
  /// Populated for EXTERNAL transfers only.
  recipientBankCode      String?
  recipientAccountNumber String?
  recipientAccountName   String?
  /// Minor units (kobo/cents) — never a float.
  amountMinorUnits       BigInt
  feeMinorUnits          BigInt
  currency               String
  narration              String
  status                 TransactionStatus @default(PENDING)
  failureReason          String?
  /// Flutterwave's own transfer ID, for EXTERNAL transfers.
  providerReference      String?
  /// Optimistic concurrency token.
  version                Int               @default(0)
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  @@index([initiatorUserId])
  @@index([sourceAccountId])
  @@index([providerReference])
  @@index([status])
  @@map("transfers")
}

// ==========================================================================
// Compliance/KYC bounded context (modules/compliance)
// `userId` is a plain scalar reference to Identity's User.id — same
// bounded-context-isolation reasoning as Account.userId above.
//
// SECURITY: raw BVN/NIN values are never persisted, only a SHA-256
// hash (dedup) and a masked display form. See
// modules/compliance/domain/entities/kyc-profile.entity.ts.
// ==========================================================================

// Mirrors shared vocabulary in modules/compliance/domain/enums/kyc-tier.enum.ts
enum KycTier {
  TIER_1
  TIER_2
  TIER_3
}

model KycProfile {
  id            String    @id @default(uuid())
  userId        String    @unique
  tier          KycTier   @default(TIER_1)
  bvnVerifiedAt DateTime?
  /// SHA-256 hash only — never the raw BVN.
  bvnHash       String?
  /// Last-4-digit masked form, e.g. "*******1234" — safe for display.
  bvnMasked     String?
  ninVerifiedAt DateTime?
  /// SHA-256 hash only — never the raw NIN.
  ninHash       String?
  ninMasked     String?
  /// Set when sanctions screening (Phase 4) finds a candidate match on
  /// this profile's verified name — an open flag pending compliance
  /// review, not an automatic block. Null once cleared or if never
  /// flagged.
  sanctionsFlaggedAt DateTime?
  /// Set when a compliance officer clears an open sanctions flag.
  /// `sanctionsFlaggedAt != null && sanctionsClearedAt == null` is
  /// what "currently flagged, needs review" means.
  sanctionsClearedAt DateTime?
  /// Optimistic concurrency token.
  version       Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([tier])
  @@index([sanctionsFlaggedAt, sanctionsClearedAt])
  @@map("kyc_profiles")
}

// Mirrors modules/compliance/domain/enums/kyc-audit-event-type.enum.ts
enum KycAuditEventType {
  VERIFICATION_ATTEMPT
  TIER_CHANGE
  SANCTIONS_SCREENING
}

// Mirrors modules/compliance/domain/enums/kyc-audit-outcome.enum.ts
enum KycAuditOutcome {
  PASSED
  FAILED
}

/// Append-only compliance audit trail (Phase 3 of
/// modules/compliance/implementation.md) — durable answer to "prove
/// this user was properly verified", which transient EventBus events
/// alone can't provide. Rows are never updated or deleted.
model KycAuditLogEntry {
  id               String            @id @default(uuid())
  userId           String
  kycProfileId     String
  eventType        KycAuditEventType
  /// Populated for VERIFICATION_ATTEMPT rows only.
  verificationType String?
  /// PASSED/FAILED for VERIFICATION_ATTEMPT rows. Reused for
  /// SANCTIONS_SCREENING rows: PASSED = screened clean, FAILED = a
  /// candidate match was found and flagged (see `notes` for which
  /// watchlist entries) — not that the screening process itself failed.
  outcome          KycAuditOutcome?
  /// Populated for VERIFICATION_ATTEMPT rows where outcome is FAILED.
  failureReason    String?
  /// Populated for TIER_CHANGE rows only.
  previousTier     KycTier?
  /// Populated for TIER_CHANGE rows only.
  newTier          KycTier?
  /// Non-null only for staff-performed actions (Phase 5b manual
  /// override, Phase 4 sanctions-flag clearing) — null means an
  /// automated/self-service event.
  performedByUserId String?
  /// Staff justification for a manual override or flag clearance, or
  /// (for SANCTIONS_SCREENING rows) which watchlist entries matched.
  /// Null for routine self-service entries.
  notes            String?
  createdAt        DateTime          @default(now())

  @@index([userId])
  @@index([kycProfileId])
  @@map("kyc_audit_log")
}

/// Seeded reference data for sanctions/PEP screening (Phase 4 of
/// modules/compliance/implementation.md) — individuals only, from the
/// free public OFAC SDN list (see infrastructure/prisma/data/README.md
/// for provenance/refresh notes). `source` future-proofs for adding
/// other lists later without a schema change.
model SanctionsListEntry {
  id           String   @id @default(uuid())
  source       String
  /// The source list's own identifier (OFAC's ent_num) — not globally unique alone, only unique per source.
  externalId   String
  fullName     String
  program      String?
  remarks      String?
  createdAt    DateTime @default(now())

  @@unique([source, externalId])
  @@index([source])
  @@map("sanctions_list_entries")
}

/// DB-configurable per-tier transfer/balance limits (Phase 1 of
/// modules/compliance/implementation.md). One row per tier; a missing
/// row falls back to the in-code defaults in
/// modules/compliance/domain/policies/kyc-tier-limits.policy.ts.
model KycTierLimit {
  tier     KycTier @id
  currency String  @default("NGN")
  /// Minor units (kobo). `null` means no cap.
  perTransactionLimit BigInt?
  /// Minor units (kobo), rolling 24h window. `null` means no cap.
  dailyTransferLimit  BigInt?
  /// Minor units (kobo). `null` means no cap.
  maxBalance          BigInt?
  updatedAt           DateTime @updatedAt

  @@map("kyc_tier_limits")
}

// ==========================================================================
// Shared cross-cutting infrastructure (shared/idempotency)
// Not owned by any one bounded context — a request-retry-safety
// mechanism any module that mutates money/state can opt into. First
// consumer is Transfers; Funding/Bills/Loans are expected to reuse
// this same table rather than each growing their own.
// ==========================================================================

enum IdempotencyKeyStatus {
  IN_PROGRESS
  COMPLETED
}

/// One row per (userId, scope, key). `scope` namespaces the key space
/// per operation (e.g. "transfer.internal") so the same client-chosen
/// key can't collide across unrelated operations. `resourceId` is only
/// populated once COMPLETED — the id of whatever was created (e.g. a
/// Transfer.id) — and is used to replay the original response instead
/// of re-executing. A cleanly-thrown business error deletes its row
/// immediately (safe to retry with the same key); a row stuck at
/// IN_PROGRESS past a short staleness window (a crashed process, not a
/// thrown exception) is reclaimed by the next attempt rather than
/// blocking forever — see shared/idempotency/idempotency-guard.service.ts.
model IdempotencyKey {
  id         String               @id @default(uuid())
  userId     String
  scope      String
  key        String
  status     IdempotencyKeyStatus @default(IN_PROGRESS)
  resourceId String?
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  @@unique([userId, scope, key])
  @@map("idempotency_keys")
}

// ==========================================================================
// Shared cross-cutting infrastructure (shared/ledger)
// Not owned by any one bounded context — an append-only double-entry
// journal any module that mutates a balance can post to. Interim,
// denormalized-projection mechanism: Account.balance remains the
// system of record for now (see Account entity's own header comment),
// this table is the durable "why" behind each change to it, and is
// meant to be reconciled against Flutterwave's own records. Expected
// to be superseded once /rust/ledger-engine is actually built out.
// See modules/transfers/implementation.md, gap #2.
//
// NOTE: `ledger_entries` already existed live on the shared dev DB
// before this table was ever added to this file — part of the
// pre-existing schema drift earlier sessions deliberately left
// untouched (see the idempotency migration's write-up). Its shape
// (userId, entryType, sourceEventId) is adopted here as-is rather than
// replaced; `journalId` is the one genuinely new column, added because
// the two pre-existing rows (test-credit-001/test-debit-001, unrelated
// single-sided test data) don't pair up as a balanced posting — nothing
// before this enforced that. `entryType` anticipates the same roadmap
// as shared/idempotency (Funding → DEPOSIT, Bills → BILL_PAYMENT).
// ==========================================================================

enum EntryDirection {
  DEBIT
  CREDIT
}

enum LedgerEntryType {
  TRANSFER
  DEPOSIT
  BILL_PAYMENT
  ADJUSTMENT
}

/// One row per leg of a balanced posting. Every `journalId` groups two
/// or more legs whose DEBITs and CREDITs must net to zero per currency
/// — enforced in code (shared/ledger/prisma-ledger-recorder.service.ts)
/// before any row is written, not by a DB constraint, since Postgres
/// can't easily express "these N rows must sum to zero" declaratively.
/// `accountId` is a plain scalar reference — either a real Accounts
/// module Account.id, or one of the well-known synthetic system
/// account ids (shared/ledger/system-ledger-account.ts) used for the
/// non-customer side of a posting (fee revenue, external-payout
/// clearing) where no real Account row exists; `balanceAfterMinorUnits`
/// is a real running balance for those too (computed from that
/// account's own prior entries), not a stand-in Account row.
/// `sourceEventId` is unique per row/leg — a dedup key for a future
/// caller that wants exactly-once posting of one event; today's
/// callers generate a fresh one per leg and rely on
/// shared/idempotency for request-level retry safety instead.
model LedgerEntry {
  id                     String          @id @default(uuid())
  journalId              String
  accountId              String
  userId                 String
  direction              EntryDirection
  /// Minor units (kobo/cents) — always positive; `direction` carries the sign.
  amountMinorUnits       BigInt
  balanceAfterMinorUnits BigInt
  currency               String
  entryType              LedgerEntryType
  /// The originating Transfer's reference — links entries back to it.
  reference              String
  sourceEventId          String          @unique
  occurredAt             DateTime
  createdAt              DateTime        @default(now())

  @@index([accountId, occurredAt])
  @@index([userId, occurredAt])
  @@index([reference])
  @@index([journalId])
  @@map("ledger_entries")
}
