# ==========================================================================
# Kudi AI Bank — Environment Variables (Example)
# Copy to .env for local development. Never commit real secrets.
# ==========================================================================

# --- App ---
NODE_ENV=development
API_PREFIX=api/v1

# --- Service Ports ---
MOBILE_API_PORT=3001
WEB_API_PORT=3002
ADMIN_API_PORT=3003
GATEWAY_PORT=8080

# --- Service URLs (for gateway routing) ---
MOBILE_API_URL=http://localhost:3001
WEB_API_URL=http://localhost:3002
ADMIN_API_URL=http://localhost:3003

# --- Database (PostgreSQL via Prisma) ---
DATABASE_URL=postgresql://kudi:kudi@localhost:5432/kudi_dev?schema=public

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# --- RabbitMQ ---
RABBITMQ_URL=amqp://localhost:5672
RABBITMQ_QUEUE=kudi_events

# --- JWT / Auth ---
JWT_ACCESS_SECRET=change_me_access_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=kudi-ai-bank

# --- CORS ---
# frontend/'s Vite dev server default is 5173, not React's usual 3000 —
# get this wrong and every request fails as a generic "Failed to fetch"
# in the browser, no status code, since CORS failures are blocked
# before the response ever reaches JS.
CORS_ORIGIN=http://localhost:5173

# --- Rate Limiting ---
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100
# Leave unset (or 0) unless this app is only reachable through a
# trusted reverse proxy/gateway — set to the real number of hops
# between the internet and this process (usually 1) so rate limiting
# buckets by the real client IP instead of the proxy's. Do NOT set
# this without a real proxy in front: it lets any caller spoof their
# IP via X-Forwarded-For and bypass rate limiting entirely.
TRUST_PROXY_HOPS=0

# --- Flutterwave (sole payment provider) ---
FLUTTERWAVE_BASE_URL=https://api.flutterwave.com/v3
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_ENCRYPTION_KEY=
FLUTTERWAVE_WEBHOOK_SECRET_HASH=
FLUTTERWAVE_TRANSFER_CALLBACK_URL=https://api.kudiaibank.com/webhooks/flutterwave/transfers

# --- Bank Identity (NUBAN generation, interbank rails) ---
BANK_NUBAN_CODE=999
BANK_NAME=Kudi AI Bank

# --- Logging ---
LOG_LEVEL=info

# --- Object Storage ---
STORAGE_PROVIDER=s3
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# --- Field-level Encryption (KYC data at rest) ---
ENCRYPTION_KEY=

# --- Compliance/KYC — Identifier Protection ---
# Keys BVN/NIN HMAC digests so they can't be brute-forced offline the way
# an unkeyed hash can (only 10^11 possible 11-digit values). High-entropy,
# 32+ characters, generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
KYC_IDENTIFIER_HMAC_KEY=
