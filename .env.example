# ==========================================================================
# Kudi AI Bank — Environment Variables (Example)
# Copy to .env for local development. Never commit real secrets.
# ==========================================================================

# --- App ---
NODE_ENV=development
API_PREFIX=api/v1

# --- Service Ports ---
MOBILE_API_PORT=3001
WEB_API_PORT=3002
ADMIN_API_PORT=3003
GATEWAY_PORT=8080

# --- Service URLs (for gateway routing) ---
MOBILE_API_URL=http://localhost:3001
WEB_API_URL=http://localhost:3002
ADMIN_API_URL=http://localhost:3003

# --- Database (PostgreSQL via Prisma) ---
DATABASE_URL=postgresql://kudi:kudi@localhost:5432/kudi_dev?schema=public

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# --- RabbitMQ ---
RABBITMQ_URL=amqp://localhost:5672
RABBITMQ_QUEUE=kudi_events

# --- JWT / Auth ---
JWT_ACCESS_SECRET=change_me_access_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=kudi-ai-bank

# --- CORS ---
CORS_ORIGIN=http://localhost:3000

# --- Rate Limiting ---
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# --- Flutterwave (sole payment provider) ---
FLUTTERWAVE_BASE_URL=https://api.flutterwave.com/v3
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_ENCRYPTION_KEY=
FLUTTERWAVE_WEBHOOK_SECRET_HASH=
FLUTTERWAVE_TRANSFER_CALLBACK_URL=https://api.kudiaibank.com/webhooks/flutterwave/transfers
FLUTTERWAVE_CHECKOUT_REDIRECT_URL=https://api.kudiaibank.com/funding/checkout/callback

# --- Bank Identity (NUBAN generation, interbank rails) ---
BANK_NUBAN_CODE=999
BANK_NAME=Kudi AI Bank

# --- Ledger Engine (Rust gRPC service) ---
# LEDGER_ENGINE_ENABLED=false keeps Transfers on the local
# Prisma-transaction executor (no Rust service required). Set to true
# once /rust/ledger-engine is deployed and reachable.
LEDGER_ENGINE_ENABLED=false
LEDGER_ENGINE_URL=localhost:50051

# --- Logging ---
LOG_LEVEL=info

# --- Object Storage ---
STORAGE_PROVIDER=s3
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# --- Field-level Encryption (KYC data at rest) ---
ENCRYPTION_KEY=
